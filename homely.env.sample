# home_agile.env
#
# Multi-profile configuration for homely.py
#
# Do NOT commit this file to Git because it contains Homely passwords.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=from_mail
EMAIL_FROM_NAME='Revised Hot Water Heating schedule'
EMAIL_PASSWORD=password

# Profile used when --profile is not supplied.
DEFAULT_PROFILE=some_name

# Shared default. A profile can override this with PROFILE.AGILE_DHW_SLOTS.
AGILE_DHW_SLOTS=2

# ----------------------------------------------------------------------
# GrannyCottage
# ----------------------------------------------------------------------

GrannyCottage.HOMELY_EMAIL=uid
GrannyCottage.HOMELY_PASSWORD=pwd

GrannyCottage.EMAIL_TO=to_email

GrannyCottage.OCTOPUS_PRODUCT=product
GrannyCottage.OCTOPUS_TARIFF=tariff

# Optional profile-specific override:
# GrannyCottage.AGILE_DHW_SLOTS=4

# ----------------------------------------------------------------------
# Another profile
# ----------------------------------------------------------------------

#AnotherProfile.HOMELY_EMAIL=your-homely-email@example.com
#AnotherProfile.HOMELY_PASSWORD=your-homely-password

#AnotherProfile.EMAIL_TO=someone@example.com

#AnotherProfile.OCTOPUS_PRODUCT=some_product
#AnotherProfile.OCTOPUS_TARIFF=some_tariff

# Optional profile-specific override:

# AnotherProfile.AGILE_DHW_SLOTS=6
